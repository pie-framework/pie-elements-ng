{
  "name": "@pie-element/element-demo",
  "version": "0.1.2-next.3",
  "private": true,
  "description": "Shared SvelteKit demo app for any PIE element",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:iife:local": "PUBLIC_ELEMENT_DEMO_IIFE_BUNDLE_MODE=local vite dev",
    "dev:iife:hosted": "PUBLIC_ELEMENT_DEMO_IIFE_BUNDLE_MODE=hosted vite dev",
    "prebuild": "bun run generate-imports && bun run generate-docs && bun run --cwd ../.. verify:no-local-paths apps/element-demo/src/lib/element-imports.js apps/element-demo/src/lib/element-imports.d.ts",
    "build": "vite build && cp build/index.html build/404.html",
    "preview": "vite preview",
    "generate-imports": "bun run scripts/generate-element-imports.ts",
    "generate-docs": "cd ../.. && bun run cli docs:generate",
    "predev": "bun run generate-imports && bun run generate-docs && bun run --cwd ../.. verify:no-local-paths apps/element-demo/src/lib/element-imports.js apps/element-demo/src/lib/element-imports.d.ts",
    "test:e2e": "playwright test",
    "test:e2e:mcpb": "playwright test mc-populated-blank",
    "test:e2e:iife": "RUN_IIFE_E2E=1 playwright test iife-usefulness.spec.ts",
    "test:e2e:iife:suite": "RUN_IIFE_E2E=1 MATRIX_STRATEGIES=esm,iife playwright test iife-usefulness.spec.ts smoke-matrix.spec.ts",
    "test:e2e:iife:suite:orchestrated": "PIE_IIFE_EXTERNAL_SERVER=1 RUN_IIFE_E2E=1 MATRIX_STRATEGIES=esm,iife playwright test iife-usefulness.spec.ts smoke-matrix.spec.ts",
    "test:iife:bundle": "bun run scripts/test-iife-bundle-contract.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@pie-element/element-bundler": "workspace:*",
    "@pie-element/element-theme-daisyui": "workspace:*",
    "@pie-element/element-player": "workspace:*",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-code-block-lowlight": "3.18.0",
    "@tiptap/extension-document": "3.18.0",
    "@tiptap/extension-history": "3.18.0",
    "@tiptap/extension-text": "3.18.0",
    "debug": "^4.4.3",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0"
  },
  "devDependencies": {
    "@pie-element/cli": "workspace:*",
    "@pie-element/multiple-choice": "workspace:*",
    "@pie-element/shared-math-rendering-mathjax": "workspace:*",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "daisyui": "^5.5.19",
    "svelte": "^5.56.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}

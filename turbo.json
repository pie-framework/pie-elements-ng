{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "ui": "tui",
  "concurrency": "78",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "esm/**", "build/**"],
      "env": ["NODE_ENV"]
    },
    "@pie-element/element-demo#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/**/docs.contract.json",
        "../../packages/**/README.md",
        "../../packages/**/src/controller/defaults.ts",
        "../../tools/cli/src/commands/docs/**",
        "../../tools/cli/src/lib/docs/**"
      ],
      "outputs": ["build/**", "static/element-docs/**"],
      "env": ["NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}

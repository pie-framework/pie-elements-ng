{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "ui": "tui",
  "concurrency": "78",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/vite/**",
        "$TURBO_ROOT$/tools/cli/src/lib/schemas/**",
        "$TURBO_ROOT$/tools/schemas/build.ts",
        "$TURBO_ROOT$/packages/shared/editor-runtime/package.json"
      ],
      "outputs": ["dist/**", "esm/**", "build/**", "module/**"],
      "env": ["NODE_ENV"]
    },
    "@pie-element/element-demo#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/**/docs.contract.json",
        "../../packages/**/README.md",
        "../../packages/**/src/controller/defaults.ts",
        "../../packages/**/src/author/defaults.ts",
        "../../packages/**/src/author/defaults.tsx",
        "../../packages/**/src/author/defaultConfiguration.ts",
        "../../packages/**/src/types.ts",
        "../../packages/shared/types/src/**",
        "../../tools/cli/src/commands/docs/**",
        "../../tools/cli/src/lib/docs/**",
        "../../tools/cli/src/lib/schemas/**"
      ],
      "outputs": ["build/**", "static/element-docs/**"],
      "env": ["NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}

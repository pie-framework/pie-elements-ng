{
  "name": "@pie-element/shared-math-rendering-mathjax",
  "version": "0.1.2",
  "description": "MathJax adapter for PIE math rendering",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "pie-browser-esm": "./dist/browser/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && vite build && vite build --config vite.browser.config.ts && tsc --emitDeclarationOnly && tsc -p tsconfig.browser.json",
    "dev": "vite build --watch",
    "test": "vitest",
    "test:e2e": "playwright test",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "@mathjax/mathjax-mhchem-font-extension": "4.1.3",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@pie-lib/math-rendering-module": "6.0.0",
    "@playwright/test": "^1.63.0",
    "mathjax": "4.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  },
  "pie": {
    "assetPackages": {
      "mathjax": "4.1.3",
      "@mathjax/mathjax-newcm-font": "4.1.3",
      "@mathjax/mathjax-mhchem-font-extension": "4.1.3"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pie",
    "math",
    "mathjax",
    "rendering",
    "latex"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pie-framework/pie-elements-ng.git",
    "directory": "packages/shared/math-rendering-mathjax"
  },
  "homepage": "https://github.com/pie-framework/pie-elements-ng#readme",
  "bugs": {
    "url": "https://github.com/pie-framework/pie-elements-ng/issues"
  }
}

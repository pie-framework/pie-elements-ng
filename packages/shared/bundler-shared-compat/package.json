{
  "name": "@pie-element/bundler-shared",
  "version": "0.1.1",
  "type": "module",
  "description": "Deprecated compatibility wrapper for @pie-element/element-bundler",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && cp index.js index.d.ts types.js types.d.ts dist/"
  },
  "dependencies": {
    "@pie-element/element-bundler": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pie-framework/pie-elements-ng.git",
    "directory": "packages/shared/bundler-shared-compat"
  },
  "homepage": "https://github.com/pie-framework/pie-elements-ng#readme",
  "bugs": {
    "url": "https://github.com/pie-framework/pie-elements-ng/issues"
  }
}

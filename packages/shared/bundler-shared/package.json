{
  "name": "@pie-element/element-bundler",
  "version": "0.1.1",
  "type": "module",
  "description": "PIE element bundler that produces IIFE bundles compatible with pie-player-components",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && mkdir -p dist/shims && cp src/shims/*.js dist/shims/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "css-loader": "^7.1.2",
    "esbuild-loader": "^4.3.0",
    "pacote": "^21.1.0",
    "react": "^18.2.0",
    "string-hash": "^1.1.3",
    "style-loader": "^4.0.0",
    "svelte": "^5.56.8",
    "svelte-loader": "^3.2.4",
    "webpack": "^5.99.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pacote": "^11.1.8",
    "@types/string-hash": "^1.1.3",
    "@types/webpack": "^5.28.5",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pie-framework/pie-elements-ng.git",
    "directory": "packages/shared/bundler-shared"
  },
  "homepage": "https://github.com/pie-framework/pie-elements-ng#readme",
  "bugs": {
    "url": "https://github.com/pie-framework/pie-elements-ng/issues"
  }
}

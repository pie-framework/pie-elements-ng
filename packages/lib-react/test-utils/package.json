{
  "name": "@pie-lib/test-utils",
  "version": "2.0.2",
  "description": "Testing utilities for pie-lib packages with React Testing Library and MUI support",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pie-framework/pie-elements-ng.git",
    "directory": "packages/lib-react/test-utils"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.11.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/user-event": "^14.6.6",
    "prop-types": "^15.8.1",
    "@testing-library/react": "^16.3.2",
    "@mui/material": "^7.3.11",
    "@testing-library/dom": ">=7.21.4"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun x vite build && bun x tsc --emitDeclarationOnly",
    "dev": "bun x vite",
    "test": "bun x vitest run"
  },
  "devDependencies": {
    "vite": "^8.0.1",
    "typescript": "^5.9.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}

{
  "name": "@pie-lib/media-svelte",
  "version": "0.1.1",
  "private": true,
  "description": "Shared accessible media UI helpers and transcript component for Svelte PIE elements",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pie-framework/pie-elements-ng.git",
    "directory": "packages/lib-svelte/media-svelte"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@pie-element/shared-types": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "dompurify": "^3.4.14",
    "svelte": "^5.57.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "homepage": "https://github.com/pie-framework/pie-elements-ng#readme",
  "bugs": {
    "url": "https://github.com/pie-framework/pie-elements-ng/issues"
  }
}

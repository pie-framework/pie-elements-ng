{
  "name": "@pie-lib/math-input-svelte",
  "version": "0.1.0",
  "private": true,
  "description": "MathQuill wrapper components for Svelte 5",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"

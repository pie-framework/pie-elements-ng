{
  "elementName": "drag-in-the-blank",
  "packageName": "@pie-element/drag-in-the-blank",
  "framework": "react",
  "supportedModes": [
    "gather",
    "view",
    "evaluate"
  ],
  "views": [
    {
      "view": "author",
      "pie": {
        "file": "src/author/defaults.ts",
        "path": "model"
      },
      "config": {
        "file": "src/author/defaults.ts",
        "path": "configuration"
      }
    },
    {
      "view": "delivery",
      "pie": {
        "file": "src/author/defaults.ts",
        "path": "model"
      },
      "config": {
        "file": "src/author/defaults.ts",
        "path": "configuration"
      }
    }
  ]
}

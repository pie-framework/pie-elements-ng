{
  "elementName": "multi-trait-rubric",
  "packageName": "@pie-element/multi-trait-rubric",
  "framework": "react",
  "summary": "React implementation of multi-trait-rubric element",
  "supportedModes": [
    "gather",
    "view",
    "evaluate"
  ],
  "views": [
    {
      "view": "author",
      "pie": {
        "file": "src/controller/defaults.ts"
      },
      "config": {
        "file": "src/author/defaults.tsx",
        "path": "configuration"
      }
    },
    {
      "view": "delivery",
      "pie": {
        "file": "src/controller/defaults.ts"
      },
      "config": {
        "file": "src/author/defaults.tsx",
        "path": "configuration"
      }
    }
  ]
}

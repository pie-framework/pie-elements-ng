{
  "name": "@pie-element/element-player",
  "version": "0.1.2-next.0",
  "description": "Shared PIE element player web component",
  "type": "module",
  "unpkg": "./dist/pie-element-player.js",
  "jsdelivr": "./dist/pie-element-player.js",
  "main": "./dist/pie-element-player.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pie-element-player.js"
    },
    "./players": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pie-element-player.js"
    },
    "./styles.css": "./dist/pie-element-player.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite"
  },
  "dependencies": {
    "@pie-element/shared-math-rendering-mathjax": "workspace:*",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-code-block-lowlight": "3.18.0",
    "@tiptap/extension-document": "3.18.0",
    "@tiptap/extension-history": "3.18.0",
    "@tiptap/extension-text": "3.18.0",
    "@tiptap/starter-kit": "3.18.0",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/extension-code-block": "^3.20.0",
    "@tiptap/extensions": "^3.20.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "daisyui": "^5.5.19",
    "svelte": "^5.56.8",
    "tailwindcss": "^4.2.2",
    "vite": "^8.1.5",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pie-framework/pie-elements-ng.git",
    "directory": "packages/element-player"
  },
  "homepage": "https://github.com/pie-framework/pie-elements-ng#readme",
  "bugs": {
    "url": "https://github.com/pie-framework/pie-elements-ng/issues"
  },
  "sideEffects": true

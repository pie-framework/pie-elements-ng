{
  "elementName": "mc-populated-blank",
  "packageName": "@pie-element/mc-populated-blank",
  "framework": "svelte",
  "summary": "Multiple-choice option populates an inline blank in a sentence template (Svelte 5 PIE element)",
  "supportedModes": ["gather", "view", "evaluate"],
  "views": [
    {
      "view": "author",
      "pie": {
        "file": "src/controller/defaults.ts",
        "path": "model"
      },
      "config": {
        "file": "src/controller/defaults.ts",
        "path": "configuration"
      }
    },
    {
      "view": "delivery",
      "pie": {
        "file": "src/controller/defaults.ts",
        "path": "model"
      },
      "config": {
        "file": "src/controller/defaults.ts",
        "path": "configuration"
      }
    },
    {
      "view": "print",
      "pie": {
        "file": "src/controller/defaults.ts",
        "path": "model"
      },
      "config": {
        "file": "src/controller/defaults.ts",
        "path": "configuration"
      }
    }
  ]
}

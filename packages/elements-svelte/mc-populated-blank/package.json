{
  "name": "@pie-element/mc-populated-blank",
  "version": "0.3.0-next.4",
  "description": "Multiple-choice option populates an inline blank in a sentence template (Svelte 5 PIE element)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pie-framework/pie-elements-ng.git",
    "directory": "packages/elements-svelte/mc-populated-blank"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "pie": {
    "controller": "@pie-element/mc-populated-blank/controller",
    "configure": "@pie-element/mc-populated-blank/configure"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./delivery": {
      "types": "./dist/delivery/index.d.ts",
      "default": "./dist/delivery/index.js"
    },
    "./browser/delivery": {
      "default": "./dist/browser/delivery/index.js"
    },
    "./controller": {
      "types": "./dist/controller/index.d.ts",
      "default": "./dist/controller/index.js"
    },
    "./controller.js": {
      "types": "./dist/controller/index.d.ts",
      "default": "./dist/controller/index.js"
    },
    "./browser/controller": {
      "default": "./dist/browser/controller/index.js"
    },
    "./author": {
      "types": "./dist/author/index.d.ts",
      "default": "./dist/author/index.js"
    },
    "./browser/author": {
      "default": "./dist/browser/author/index.js"
    },
    "./configure": {
      "types": "./dist/author/index.d.ts",
      "default": "./dist/author/index.js"
    },
    "./print": {
      "types": "./dist/print/index.d.ts",
      "default": "./dist/print/index.js"
    },
    "./browser/print": {
      "default": "./dist/browser/print/index.js"
    },
    "./runtime-support": {
      "types": "./dist/runtime-support.d.ts",
      "default": "./dist/runtime-support.js"
    }
  },
  "files": [
    "configure.js",
    "controller.js",
    "dist",
    "module"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --config vite.delivery.config.ts && vite build --config vite.controller.config.ts && vite build --config vite.author.config.ts && vite build --config vite.print.config.ts && vite build --config ../../../tools/vite/svelte-element-browser.config.ts && vite build --config ../../../tools/vite/svelte-element-legacy-print.config.ts && vite build --config vite.runtime-support.config.ts && vite build --config vite.config.iife.ts && tsc --emitDeclarationOnly",
    "dev": "vite",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@pie-lib/delivery-events-svelte": "workspace:*",
    "@pie-lib/styling-svelte": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte": "^5.56.10",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  }
}

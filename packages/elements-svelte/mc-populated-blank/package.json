{
  "name": "@pie-element/mc-populated-blank",
  "version": "0.2.12",
  "description": "Multiple-choice option populates an inline blank in a sentence template (Svelte 5 PIE element)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "pie": {
    "controller": "@pie-element/mc-populated-blank/controller"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./delivery": {
      "types": "./dist/delivery/index.d.ts",
      "default": "./dist/delivery/index.js"
    },
    "./controller": {
      "types": "./dist/controller/index.d.ts",
      "default": "./dist/controller/index.js"
    },
    "./controller.js": {
      "types": "./dist/controller/index.d.ts",
      "default": "./dist/controller/index.js"
    },
    "./author": {
      "types": "./dist/author/index.d.ts",
      "default": "./dist/author/index.js"
    },
    "./print": {
      "types": "./dist/print/index.d.ts",
      "default": "./dist/print/index.js"
    }
  },
  "files": [
    "dist",
    "controller.js"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --config vite.delivery.config.ts && vite build --config vite.controller.config.ts && vite build --config vite.author.config.ts && vite build --config vite.print.config.ts && vite build --config vite.config.iife.ts && tsc --emitDeclarationOnly",
    "dev": "vite",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@pie-lib/delivery-events-svelte": "workspace:*",
    "@pie-lib/styling-svelte": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte": "^5.54.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  }
}

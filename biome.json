{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/esm",
      "!**/.turbo",
      "!**/coverage",
      "!**/.svelte-kit",
      "!**/.changeset",
      "!.claude",
      "!**/test-results",
      "!**/playwright-a11y-report",
      "!**/playwright-report",
      "!**/packages/apps/examples",
      "!**/packages/elements-svelte/multiple-choice/src/configure",
      "!packages/elements-react",
      "!packages/lib-react",
      "!packages/shared/*/src/index.ts",
      "!apps/*/src/lib/elements/registry.ts",
      "!apps/*/src/lib/element-imports.js",
      "!apps/*/src/lib/element-imports.d.ts",
      "!packages/elements-svelte/mc-populated-blank/src/delivery/assets/*.svg"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "off",
        "noUnusedImports": "off"
      },
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "useConst": "off",
        "useTemplate": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/shared/i18n/tests/i18n-conformance-fixtures.json",
        "docs/a11y/theme-gap-inventory.md"
      ],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "usePlaywrightValidDescribeCallback": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.spec.ts"],
      "linter": {
        "rules": {
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**", "**/vitest.config.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off"
          }
        }
      },
      "javascript": {
        "parser": {
          "unsafeParameterDecoratorsEnabled": true
        }
      }
    }
  ]
}

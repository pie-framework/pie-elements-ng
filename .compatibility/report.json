    "ESM delivery for math-inline",
    "ESM delivery for mc-populated-blank",
    "ESM delivery for simple-cloze",
    "ESM delivery for venn-classification",
    "ESM author view for one browser-ready React element",
    "ESM print or fallback path for one browser-ready React element",
    "ESM passage plus interaction item",
    "IIFE delivery for multiple-choice",
    "preloaded host-registered element",
    "intentional non-ESM-ready package rejects or routes to IIFE/preloaded"
  ]
